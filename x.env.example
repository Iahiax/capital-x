# Capital.com credentials
CAPITAL_EMAIL=your_email@example.com
CAPITAL_API_KEY=replace_me
CAPITAL_API_PASSWORD=replace_me

# Telegram bot token and the ONLY allowed chat ID
TELEGRAM_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

# Safe defaults
CAPITAL_MODE=DEMO
CAPITAL_EPIC=CS.D.EURUSD.MINI
ORDER_SIZE=1
MAX_ORDER_SIZE=1
POLL_SECONDS=1
REQUEST_TIMEOUT=20
ENABLE_LIVE_MODE=false
SEND_TELEGRAM_REPLIES=true
LOG_LEVEL=INFO
